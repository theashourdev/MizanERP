{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=MizanERP;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "JwtSettings": {
    "Secret": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_MIN_32_CHARS!!",
    "Issuer": "MizanERP",
    "Audience": "MizanERPUsers",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshTokenRememberMeDays": 30
  },

  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "EnableSsl": true,
    "SmtpUsername": "your-email@gmail.com",
    "SmtpPassword": "xxxx xxxx xxxx xxxx",
    "FromEmail": "your-email@gmail.com",
    "FromName": "YourAppName"
  },

  "SmsSettings": {
    "Enabled": false,
    "Twilio": {
      "AccountSid": "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
      "AuthToken": "your-auth-token",
      "FromPhone": "+1234567890"
    }
  },

  "AppSettings": {
    "AppName": "MizanERP",
    "ClientUrl": "https://localhost:7048",
    "DefaultRole": "User",
    "DefaultUserPassword": "P@ssw0rd"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Error"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/App-.txt",
          "restrictedToMinimumLevel": "Information",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}Controller: {Controller} | Action: {Action} | User: {User}{NewLine}---------------------------------------{NewLine}",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },

  "AllowedHosts": "*"
}
