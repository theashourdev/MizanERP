@model MizanERP.Domain.Entities.Supplier

@{
    ViewData["Title"] = "Supplier Details";
}

<style>
    :root {
        --d-accent:      #4f6ef7;
        --d-accent-soft: #eef0fe;
        --d-text:        #1a1d23;
        --d-muted:       #6b7280;
        --d-border:      #e5e7eb;
        --d-surface:     #ffffff;
        --d-bg:          #f7f8fc;
        --d-shadow:      0 4px 24px rgba(79,110,247,.09), 0 1px 4px rgba(0,0,0,.07);
    }

    body { background: var(--d-bg); }

    .d-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: .82rem;
        color: var(--d-muted);
        text-decoration: none;
        margin-bottom: 22px;
        transition: color .15s;
    }
    .d-back:hover { color: var(--d-accent); }

    /* ── Card ── */
    .d-card {
        background: var(--d-surface);
        border-radius: 18px;
        border: 1.5px solid var(--d-border);
        box-shadow: var(--d-shadow);
        overflow: hidden;
    }
    .d-card-stripe {
        height: 4px;
        background: linear-gradient(90deg, var(--d-accent) 0%, #818cf8 100%);
    }
    .d-card-inner { padding: 32px 36px 36px; }

    /* ── Header ── */
    .d-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 32px;
    }
    .d-avatar {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        background: var(--d-accent-soft);
        color: var(--d-accent);
        font-weight: 800;
        font-size: 1.4rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        letter-spacing: -.5px;
    }
    .d-name {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--d-text);
        letter-spacing: -.4px;
        margin: 0;
    }
    .d-sub {
        font-size: .8rem;
        color: var(--d-muted);
        margin-top: 3px;
    }

    /* ── Section divider ── */
    .d-section {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 24px 0 16px;
    }
    .d-section-icon {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: var(--d-accent-soft);
        color: var(--d-accent);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .d-section-label {
        font-size: .78rem;
        font-weight: 700;
        color: var(--d-muted);
        text-transform: uppercase;
        letter-spacing: .08em;
    }
    .d-section-line {
        flex: 1;
        height: 1px;
        background: var(--d-border);
    }

    /* ── Fields ── */
    .d-field {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px 14px;
        border-radius: 10px;
        background: #fafafa;
        border: 1px solid var(--d-border);
        margin-bottom: 10px;
    }
    .d-field-icon {
        color: var(--d-muted);
        flex-shrink: 0;
        margin-top: 2px;
    }
    .d-field-label {
        font-size: .75rem;
        font-weight: 600;
        color: var(--d-muted);
        text-transform: uppercase;
        letter-spacing: .06em;
        margin-bottom: 2px;
    }
    .d-field-value {
        font-size: .9rem;
        color: var(--d-text);
        font-weight: 500;
        line-height: 1.5;
    }
    .d-field-value.empty { color: #c4cad4; font-weight: 400; }

    /* ── Footer ── */
    .d-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 32px;
        padding-top: 22px;
        border-top: 1px solid var(--d-border);
    }
    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--d-muted);
        font-size: .875rem;
        font-weight: 600;
        text-decoration: none;
        padding: 9px 18px;
        border-radius: 9px;
        border: 1.5px solid var(--d-border);
        background: #fff;
        transition: all .15s;
    }
    .btn-back:hover { background: #f3f4f6; color: var(--d-text); }

    .btn-edit-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: var(--d-accent);
        color: #fff;
        font-size: .875rem;
        font-weight: 700;
        border-radius: 9px;
        padding: 10px 22px;
        text-decoration: none;
        box-shadow: 0 2px 10px rgba(79,110,247,.3);
        transition: background .18s, transform .12s, box-shadow .18s;
    }
    .btn-edit-link:hover {
        background: #3a58e0;
        color: #fff;
        transform: translateY(-1px);
        box-shadow: 0 4px 16px rgba(79,110,247,.4);
    }
</style>

<div class="container" style="max-width:660px; padding-top:10px;">

    <a class="d-back" asp-action="Index">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        Back to Suppliers
    </a>

    <div class="d-card">
        <div class="d-card-stripe"></div>
        <div class="d-card-inner">

            <!-- Header -->
            <div class="d-header">
                <div class="d-avatar">@(Model.Name.Length > 0 ? Model.Name.Substring(0,1).ToUpper() : "?")</div>
                <div>
                    <div class="d-name">@Model.Name</div>
                    <div class="d-sub">Supplier profile</div>
                </div>
            </div>

            <!-- Basic Info -->
            <div class="d-section">
                <div class="d-section-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </div>
                <span class="d-section-label">Basic Info</span>
                <div class="d-section-line"></div>
            </div>

            <div class="d-field">
                <div class="d-field-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.8 19.8 0 0 1 3.08 4.18 2 2 0 0 1 5.09 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L9.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 23 17z"/></svg>
                </div>
                <div>
                    <div class="d-field-label">Contact Info</div>
                    @if (string.IsNullOrEmpty(Model.ContactInfo))
                    {
                        <div class="d-field-value empty">No contact info provided</div>
                    }
                    else
                    {
                        <div class="d-field-value">@Model.ContactInfo</div>
                    }
                </div>
            </div>

            <!-- Address -->
            <div class="d-section">
                <div class="d-section-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </div>
                <span class="d-section-label">Address</span>
                <div class="d-section-line"></div>
            </div>

            <div class="d-field">
                <div class="d-field-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
                </div>
                <div>
                    <div class="d-field-label">Full Address</div>
                    @if (Model.Address != null)
                    {
                        <div class="d-field-value">
                            @Model.Address.Line1<br />
                            @if (!string.IsNullOrEmpty(Model.Address.Line2))
                            {
                                @Model.Address.Line2<br />
                            }
                            @Model.Address.City, @Model.Address.State @Model.Address.PostalCode<br />
                            @Model.Address.Country
                        </div>
                    }
                    else
                    {
                        <div class="d-field-value empty">No address provided</div>
                    }
                </div>
            </div>

            <!-- Footer -->
            <div class="d-footer">
                <a class="btn-back" asp-action="Index">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
                    Back
                </a>
                <a class="btn-edit-link" asp-action="Edit" asp-route-id="@Model.Id">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4z"/></svg>
                    Edit Supplier
                </a>
            </div>

        </div>
    </div>
</div>
