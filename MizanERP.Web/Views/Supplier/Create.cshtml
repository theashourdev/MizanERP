@model MizanERP.Application.DTOs.CreateSupplierDto

@{
    ViewData["Title"] = "Create Supplier";
}

<style>
    :root {
        --f-accent:       #4f6ef7;
        --f-accent-soft:  #eef0fe;
        --f-text:         #1a1d23;
        --f-muted:        #6b7280;
        --f-border:       #e5e7eb;
        --f-border-focus: #4f6ef7;
        --f-surface:      #ffffff;
        --f-bg:           #f7f8fc;
        --f-radius:       12px;
        --f-shadow:       0 4px 24px rgba(79,110,247,.09), 0 1px 4px rgba(0,0,0,.07);
    }

    body { background: var(--f-bg); }

    /* ── Back breadcrumb ── */
    .f-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: .82rem;
        color: var(--f-muted);
        text-decoration: none;
        margin-bottom: 22px;
        transition: color .15s;
    }
    .f-back:hover { color: var(--f-accent); }

    /* ── Card ── */
    .f-card {
        background: var(--f-surface);
        border-radius: 18px;
        border: 1.5px solid var(--f-border);
        box-shadow: var(--f-shadow);
        overflow: hidden;
    }

    /* Card top stripe */
    .f-card-stripe {
        height: 4px;
        background: linear-gradient(90deg, var(--f-accent) 0%, #818cf8 100%);
    }

    .f-card-inner { padding: 32px 36px 36px; }

    /* ── Page title ── */
    .f-title {
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--f-text);
        letter-spacing: -.4px;
        margin-bottom: 4px;
    }
    .f-subtitle {
        font-size: .82rem;
        color: var(--f-muted);
        margin-bottom: 32px;
    }

    /* ── Section divider ── */
    .f-section {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 28px 0 18px;
    }
    .f-section-icon {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: var(--f-accent-soft);
        color: var(--f-accent);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .f-section-label {
        font-size: .78rem;
        font-weight: 700;
        color: var(--f-muted);
        text-transform: uppercase;
        letter-spacing: .08em;
    }
    .f-section-line {
        flex: 1;
        height: 1px;
        background: var(--f-border);
    }

    /* ── Form fields ── */
    .f-label {
        font-size: .82rem;
        font-weight: 600;
        color: #374151;
        margin-bottom: 5px;
        display: block;
    }
    .f-label .opt {
        font-weight: 400;
        color: #9ca3af;
        font-size: .76rem;
        margin-left: 4px;
    }

    .form-control {
        border: 1.5px solid var(--f-border);
        border-radius: 9px;
        font-size: .875rem;
        padding: 9px 13px;
        color: var(--f-text);
        background: #fafafa;
        transition: border-color .18s, box-shadow .18s, background .18s;
    }
    .form-control:focus {
        border-color: var(--f-border-focus);
        box-shadow: 0 0 0 3px rgba(79,110,247,.12);
        background: #fff;
        outline: none;
    }
    .form-control::placeholder { color: #c4cad4; }
    .text-danger { font-size: .76rem; margin-top: 3px; }

    /* ── Footer buttons ── */
    .f-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 36px;
        padding-top: 24px;
        border-top: 1px solid var(--f-border);
    }
    .btn-cancel {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--f-muted);
        font-size: .875rem;
        font-weight: 600;
        text-decoration: none;
        padding: 9px 18px;
        border-radius: 9px;
        border: 1.5px solid var(--f-border);
        transition: all .15s;
        background: #fff;
    }
    .btn-cancel:hover { background: #f3f4f6; border-color: #d1d5db; color: var(--f-text); }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: var(--f-accent);
        color: #fff;
        font-size: .875rem;
        font-weight: 700;
        border: none;
        border-radius: 9px;
        padding: 10px 24px;
        box-shadow: 0 2px 10px rgba(79,110,247,.3);
        transition: background .18s, transform .12s, box-shadow .18s;
        cursor: pointer;
    }
    .btn-submit:hover {
        background: #3a58e0;
        transform: translateY(-1px);
        box-shadow: 0 4px 16px rgba(79,110,247,.4);
    }
    .btn-submit:active { transform: translateY(0); }
</style>

<div class="container" style="max-width:680px; padding-top:10px;">

    <a class="f-back" asp-action="Index">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        Back to Suppliers
    </a>

    <div class="f-card">
        <div class="f-card-stripe"></div>
        <div class="f-card-inner">

            <div class="f-title">New Supplier</div>
            <div class="f-subtitle">Fill in the details below to add a new supplier.</div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <!-- ── Basic info ── -->
                <div class="f-section">
                    <div class="f-section-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </div>
                    <span class="f-section-label">Basic Info</span>
                    <div class="f-section-line"></div>
                </div>

                <div class="mb-3">
                    <label asp-for="Name" class="f-label">Supplier Name</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Al-Noor Trading Co." />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-1">
                    <label asp-for="ContactInfo" class="f-label">
                        Contact Info
                        <span class="opt">(optional)</span>
                    </label>
                    <input asp-for="ContactInfo" class="form-control" placeholder="Phone, email, or notes" />
                    <span asp-validation-for="ContactInfo" class="text-danger"></span>
                </div>

                <!-- ── Address ── -->
                <div class="f-section">
                    <div class="f-section-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    </div>
                    <span class="f-section-label">Address <span style="font-weight:400;text-transform:none;letter-spacing:0;font-size:.72rem;">(optional)</span></span>
                    <div class="f-section-line"></div>
                </div>

                <div class="mb-3">
                    <label asp-for="Address.Line1" class="f-label">Address Line 1</label>
                    <input asp-for="Address.Line1" class="form-control" placeholder="Street, building number" />
                    <span asp-validation-for="Address.Line1" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Address.Line2" class="f-label">
                        Address Line 2
                        <span class="opt">(optional)</span>
                    </label>
                    <input asp-for="Address.Line2" class="form-control" placeholder="Apt, suite, floor" />
                    <span asp-validation-for="Address.Line2" class="text-danger"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-5">
                        <label asp-for="Address.City" class="f-label">City</label>
                        <input asp-for="Address.City" class="form-control" placeholder="City" />
                        <span asp-validation-for="Address.City" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Address.State" class="f-label">State</label>
                        <input asp-for="Address.State" class="form-control" placeholder="State" />
                        <span asp-validation-for="Address.State" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Address.PostalCode" class="f-label">Postal Code</label>
                        <input asp-for="Address.PostalCode" class="form-control" placeholder="00000" />
                        <span asp-validation-for="Address.PostalCode" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-1">
                    <label asp-for="Address.Country" class="f-label">Country</label>
                    <input asp-for="Address.Country" class="form-control" placeholder="Country" />
                    <span asp-validation-for="Address.Country" class="text-danger"></span>
                </div>

                <!-- ── Footer ── -->
                <div class="f-footer">
                    <a asp-action="Index" class="btn-cancel">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
                        Cancel
                    </a>
                    <button type="submit" class="btn-submit">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
                        Create Supplier
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
