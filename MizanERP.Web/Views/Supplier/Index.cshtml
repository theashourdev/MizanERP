@* @model IEnumerable<MizanERP.Domain.Entities.Supplier>

@{
    ViewData["Title"] = "Suppliers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Suppliers</h1>
        <small class="text-muted">Manage suppliers and procurement contacts</small>
    </div>
    <div class="d-flex gap-2">
        <input id="supSearch" class="form-control" style="min-width:260px" placeholder="Search suppliers..." />
        <a class="btn btn-primary" asp-action="Create">Create Supplier</a>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-2 g-3" id="supplierCards">
    @foreach (var s in Model)
    {
        <div class="col" data-id="@s.Id">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex">
                    <div class="flex-grow-1">
                        <h5 class="card-title mb-1">@s.Name</h5>
