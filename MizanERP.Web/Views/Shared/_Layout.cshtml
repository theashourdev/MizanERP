<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MizanERP</title>

    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MizanERP.Web.styles.css" asp-append-version="true" />
    <style>
        .navbar-brand { font-weight:700; color:#1e3a5f !important; }
        .sidebar { min-width:220px; }
        .content-area { margin-left: 240px; padding-top:20px; }
        .sidebar .nav-link { color:#333; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">MizanERP</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="/">Dashboard</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="masterDataMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">Master Data</a>
                            <ul class="dropdown-menu" aria-labelledby="masterDataMenu">
                                <li><a class="dropdown-item" asp-action="Index" asp-controller = "Product">Products</a></li>
                                <li><a class="dropdown-item" asp-action="Index" asp-controller = "Customer">Customers</a></li>
                                <li><a class="dropdown-item" asp-action="Index" asp-controller = "Supplier">Suppliers</a></li>
                                <li><a class="dropdown-item" asp-action="Index" asp-controller = "Purchase">Purchase</a></li>
                            </ul>
                        </li>
                    </ul>
                    <form class="d-flex me-3" role="search">
                        <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search">
                        <button class="btn btn-outline-primary" type="submit">Search</button>
                    </form>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" href="/Identity/Account/Login">Login</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid">
        <div class="row">
            @RenderBody()
        </div>
    </div>

    <footer class="footer mt-auto py-3 bg-light border-top">
        <div class="container text-center">
            <span class="text-muted">&copy; 2026 - MizanERP</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @await Component.InvokeAsync("Notyf")

	<script>
		(function () {
			function dismissAll() {
				if (typeof notyf !== 'undefined') notyf.dismissAll();
				if (typeof toastr !== 'undefined') toastr.remove();
			}

			// Patch notyf — dismiss both before showing
			if (typeof notyf !== 'undefined') {
				const _nSuccess = notyf.success.bind(notyf);
				const _nError   = notyf.error.bind(notyf);
				notyf.success = function (p) { dismissAll(); return _nSuccess(p); };
				notyf.error   = function (p) { dismissAll(); return _nError(p);   };
			}

			// Patch toastr — dismiss both before showing
			if (typeof toastr !== 'undefined') {
				const _tSuccess = toastr.success.bind(toastr);
				const _tError   = toastr.error.bind(toastr);
				const _tWarning = toastr.warning.bind(toastr);
				const _tInfo    = toastr.info.bind(toastr);
				toastr.success = function (m, t, o) { dismissAll(); return _tSuccess(m, t, o); };
				toastr.error   = function (m, t, o) { dismissAll(); return _tError(m, t, o);   };
				toastr.warning = function (m, t, o) { dismissAll(); return _tWarning(m, t, o); };
				toastr.info    = function (m, t, o) { dismissAll(); return _tInfo(m, t, o);    };
			}
		})();
	</script>

</body>
</html>
