@using MizanERP.Web.Controllers
@model List<MizanERP.Domain.Entities.PurchaseOrder>

@{
    ViewData["Title"] = "Purchase History";
}

<style>
    .p-card { background: #fff; border-radius: 14px; border: 1px solid #e6e6ef; padding: 18px; }
    .p-table thead th { border-bottom: none; }
    .p-actions .btn { margin-right:6px; }
</style>

<div class="container" style="max-width:1100px; padding-top:12px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Purchase History</h3>
        <div>
            <a class="btn btn-outline-secondary" asp-action="Create">New Purchase</a>
        </div>
    </div>

    <div class="p-card">
        <table class="table p-table table-hover align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Supplier</th>
                    <th>Buyer</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var po in Model)
                {
                    var supplierName = ViewBag.Suppliers != null && ((Dictionary<Guid, string>)ViewBag.Suppliers).ContainsKey(po.SupplierId) ? ((Dictionary<Guid, string>)ViewBag.Suppliers)[po.SupplierId] : po.SupplierId.ToString();
                    var buyerName = "-";
                    if (po.BuyerId.HasValue && ViewBag.Users != null)
                    {
                        var usersDict = (Dictionary<Guid, string>)ViewBag.Users;
                        if (usersDict.ContainsKey(po.BuyerId.Value)) buyerName = usersDict[po.BuyerId.Value];
                    }

                    <tr>
                        <td>@po.OrderDate.ToString("yyyy-MM-dd")</td>
                        <td>@supplierName</td>
                        <td>@buyerName</td>
                        <td>@po.GetTotal().Amount.ToString("N2") @po.GetTotal().Currency</td>
                        <td class="p-actions text-end">
                            <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@po.Id">Details</a>
                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Details", new { id = po.Id, print = true })">Print</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
