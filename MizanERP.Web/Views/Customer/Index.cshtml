@model IEnumerable<MizanERP.Domain.Entities.Customer>

@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Customers</h1>
        <small class="text-muted">Manage customers and their contact details</small>
    </div>
    <div class="d-flex gap-2">
        <input id="custSearch" class="form-control" style="min-width:260px" placeholder="Search customers..." />
        <a class="btn btn-primary" asp-action="Create">Create Customer</a>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-2 g-3">
    @foreach (var c in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex">
                    <div class="flex-grow-1">
                        <h5 class="card-title mb-1">@c.Name</h5>
                        <p class="mb-1 text-muted">@(string.IsNullOrEmpty(c.ContactInfo) ? "-" : c.ContactInfo)</p>
                        @if (c.Address != null)
                        {
                            <p class="mb-0 small text-muted">@c.Address.Line1, @c.Address.City</p>
                        }
                    </div>
                    <div class="d-flex flex-column align-items-end ms-3">
                        <a class="btn btn-sm btn-outline-primary mb-1" asp-action="Details" asp-route-id="@c.Id">View</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            const rows = Array.from(document.querySelectorAll('.card.h-100'));
            const input = document.getElementById('custSearch');
            input.addEventListener('input', () => {
                const q = input.value.trim().toLowerCase();
                rows.forEach(card => {
                    card.style.display = card.innerText.toLowerCase().indexOf(q) !== -1 ? '' : 'none';
                });
            });
        })();
    </script>
}