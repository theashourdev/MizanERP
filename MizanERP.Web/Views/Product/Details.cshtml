@model MizanERP.Domain.Entities.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h3 class="mb-0">@Model.Name</h3>
                        <small class="text-muted">@Model.Code</small>
                    </div>
                    <div>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </div>
                </div>

                <dl class="row">
                    <dt class="col-sm-4">Product Type</dt>
                    <dd class="col-sm-8">@Model.Type</dd>

                    <dt class="col-sm-4">Unit</dt>
                    <dd class="col-sm-8">@Model.Unit</dd>

                    <dt class="col-sm-4">Available Quantity</dt>
                    <dd class="col-sm-8">@Model.InventoryQuantity</dd>

                    <dt class="col-sm-4">Created At</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                    <dt class="col-sm-4">Last Updated</dt>
                    <dd class="col-sm-8">@Model.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                </dl>

                <div class="mt-3">
                    <a class="btn btn-primary me-2" asp-action="Index">Back</a>
                    <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card mb-4 shadow-sm">
            <div class="card-body text-center">
                <h5 class="card-title">Quick Stats</h5>
                <div class="row text-center">
                    <div class="col-12">
                        <div class="display-6">@Model.InventoryQuantity</div>
                        <small class="text-muted">Current Stock</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <h6>Actions</h6>
                <a class="btn btn-sm btn-outline-danger w-100 mb-2">Delete</a>
                <a class="btn btn-sm btn-outline-primary w-100">Create Transaction</a>
            </div>
        </div>
    </div>
</div>