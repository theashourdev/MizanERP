using System;
using MizanERP.Domain.Enums;

namespace MizanERP.Domain.Entities
{
    public class InventoryMovement
    {
        public Guid Id { get; private set; }
        public Guid ProductId { get; private set; }
        public Guid? FromWarehouseId { get; private set; }
        public Guid? ToWarehouseId { get; private set; }
        public decimal Quantity { get; private set; }
        public decimal? Cost { get; private set; }
        public MovementType MovementType { get; private set; }
        public DateTime Date { get; private set; }
        public string? Reference { get; private set; } // e.g., PO number, SO number, etc.

        public InventoryMovement(Guid id, Guid productId, decimal quantity, MovementType movementType, DateTime date, Guid? fromWarehouseId = null, Guid? toWarehouseId = null, decimal? cost = null, string? reference = null)
        {
            if (quantity <= 0)
                throw new ArgumentException("Quantity must be positive");
            Id = id;
            ProductId = productId;
            Quantity = quantity;
            MovementType = movementType;
            Date = date;
            FromWarehouseId = fromWarehouseId;
            ToWarehouseId = toWarehouseId;
            Cost = cost;
            Reference = reference;
        }
    }
}